# MongoDB Configuration
MONGO_USER=admin
MONGO_PASS=password
MONGO_HOST=db
MONGO_PORT=27017
MONGO_DB=cat_health

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-for-sessions-change-in-production
FLASK_DEBUG=False

# JWT Configuration
# If not set, JWT_SECRET_KEY defaults to FLASK_SECRET_KEY
# JWT_SECRET_KEY=your-jwt-secret-key

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash

# To generate a password hash, run:
# python -c "import bcrypt; print(bcrypt.hashpw('your_password'.encode(), bcrypt.gensalt()).decode())"

# Logging Configuration (used for both Flask app and Gunicorn)
# LOG_LEVEL=INFO

# Rate Limiting Configuration
# If not set, RATELIMIT_STORAGE_URI defaults to MongoDB URI
# RATELIMIT_STORAGE_URI=mongodb://admin:password@db:27017/cat_health?authSource=admin

# Cookie Security (set COOKIE_SECURE=true behind HTTPS)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=Lax

# CORS Configuration
# Comma-separated list of allowed origins. If empty, the Origin header is reflected
# (suitable for local development with Nginx proxy). Set explicitly in production.
# CORS_ALLOWED_ORIGINS=https://your.domain

# Gunicorn Configuration (optional)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4

# Daily database backup to the bucket's backups/mongo/ (optional tuning)
# How many backups to keep, newest first (default: 3)
# BACKUP_KEEP=3
# Hour of the day, UTC, to back up at (default: 0)
# BACKUP_HOUR_UTC=0

# Web Push (VAPID) — optional. Without these, the app still runs fine;
# push notifications are simply unavailable (GET /api/push/vapid-public-key
# returns push_not_configured, and Settings shows the toggle as disabled).
# Generate a key pair with:
#   python -m scripts.generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=admin@example.com

# Object storage for files (Backblaze B2, S3-compatible API). Endpoint,
# region and bucket are not secret; the key pair is. In production the
# deploy workflow writes all five from the workflow file and the
# S3_KEY_ID / S3_SECRET_KEY repository secrets:
#   gh secret set S3_KEY_ID
#   gh secret set S3_SECRET_KEY
# For local runs put your own values in .env (git-ignored), never here.
# scripts/dev_local.py reads them and uses the same bucket, with every key
# under dev/ (S3_PREFIX), which it empties on start; production keys
# (users/...) are never touched. DEV_STORAGE=memory runs an in-memory S3.
# Check a key with:  .venv/bin/python scripts/check_storage.py
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_BUCKET=petzy-1
# S3_KEY_ID=<keyID of an application key limited to the bucket>
# S3_SECRET_KEY=<its applicationKey>
# Namespace for every key; empty in production. Local runs set dev/ so
# they share the bucket without touching production's users/ and backups/.
# S3_PREFIX=dev/
