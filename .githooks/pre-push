#!/bin/sh
# Runs the full backend test suite and a full frontend lint before
# allowing a push — catches regressions and drift the fast per-commit
# staged-files-only checks can't (e.g. a file that changed across
# several commits, or a --no-verify commit).
# Enabled via: git config core.hooksPath .githooks (one-time per clone).

status=0

if [ -x .venv/bin/python ]; then
    PYTHON=.venv/bin/python
else
    PYTHON=python3
fi
if [ -x .venv/bin/ruff ]; then
    RUFF=.venv/bin/ruff
else
    RUFF=ruff
fi

echo "Running ruff (check + format) over the whole backend before push..."
$RUFF check .
[ $? -ne 0 ] && status=1
$RUFF format --check .
[ $? -ne 0 ] && status=1

echo ""
echo "Running backend test suite before push..."
$PYTHON -m pytest tests/ --tb=short -q
[ $? -ne 0 ] && status=1

echo ""
echo "Running full frontend lint before push..."
(
    cd frontend || exit 1
    npm run lint
)
[ $? -ne 0 ] && status=1

if [ $status -ne 0 ]; then
    echo ""
    echo "Checks failed — fix them or run 'git push --no-verify' to skip (not recommended)."
    exit 1
fi

exit 0
