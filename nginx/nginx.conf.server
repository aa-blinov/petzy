# A copy of the host's own nginx file, /etc/nginx/sites-enabled/cat-health-control, as it stood on
# 2026-10-11. It is here to be read and compared, not deployed: the host file is edited by hand on
# the server, because the deploy user has no sudo. Change one, change the other.
#
# It does far less than it used to. An earlier version served the built frontend from a directory on
# the host and proxied /api/ straight to gunicorn on 5001; both are gone. Now the host only
# terminates TLS and forwards everything to the app's own nginx at 127.0.0.1:3000, which is what
# routes, caches and sets headers. That is why nothing here mentions /api/, /assets or /health:
# those are decided by nginx/nginx.conf inside the container, which is the file that really runs and
# the one to change for anything about how the app is served.
#
# What is left here is TLS and forwarding. Two things to keep in mind when editing:
#   - X-Forwarded-For appends, and the container trusts this hop, so the visitor's real address
#     survives a client that sends its own X-Forwarded-For.
#   - This nginx adds nosniff and HSTS through Certbot's include, and the container adds them too,
#     so API answers carry both headers twice. Harmless, and it only goes away by dropping one of
#     the two, which is a decision to make deliberately rather than by accident.

server {
    server_name petzy.duckdns.org;

    # Логи
    access_log /var/log/nginx/cat-health-control-access.log;
    error_log /var/log/nginx/cat-health-control-error.log;

    # Увеличение размера загружаемых файлов
    client_max_body_size 10M;

    # Весь трафик — в nginx приложения, он слушает только на петле
    location / {
        proxy_pass http://127.0.0.1:3000; # Направляем трафик на внутренний Nginx в Docker
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Таймауты
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/petzy.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/petzy.duckdns.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = petzy.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name petzy.duckdns.org;
    return 404; # managed by Certbot
}
